# Local Git metadata used because the desktop workspace exposes a read-only .git mount.
.clearcut-git/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/

# JavaScript / TypeScript
node_modules/
.next/
out/
dist/
coverage/
.turbo/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# IDE and OS files
.DS_Store
.idea/
.vscode/settings.json
*.swp

# Generated artifacts
tmp/
artifacts/
uploads/
# Keep the application route at apps/web/app/reports tracked and included in builds.
# Generated report artifacts should use a more specific directory name.
report-artifacts/
*.log
.data/
*.db
